{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,         // catches null/undefined issues and other common type bugs at compile time
    "esModuleInterop": true,
    "types": ["node", "@playwright/test"], // makes Node.js and Playwright globals available without explicit imports
    "skipLibCheck": true
  },
  // explicit list so TS only compiles project source files
  "include": [
    "api/**/*.ts",
    "components/**/*.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "test-data/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.ts",
    "playwright.config.ts"
  ]
}